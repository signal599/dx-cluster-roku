# Copy to .env and fill in. .env is git-ignored.

# Cluster connection (baked into the package at build time)
CLUSTER_HOST=
CLUSTER_PORT=7300
CLUSTER_CALLSIGN=
# telnet-login (log in with CLUSTER_CALLSIGN) or raw (send nothing)
CLUSTER_MODE=telnet-login

# Dev Roku (used by tools/deploy.sh only; never packaged)
ROKU_IP=192.168.1.100
ROKU_PASSWORD=changeme
